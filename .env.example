# Ninja Harness — example environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Optional: set to enable future LLM-as-judge integrations (v0.2+)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default log level (DEBUG, INFO, WARNING, ERROR)
# NINJA_LOG_LEVEL=INFO

# Optional: path to a custom baseline JSON for stability scoring
# NINJA_BASELINE_PATH=./baselines/my_agent_baseline.json
